{
  "manifest_version": 3,
  "name": "Twitter Bookmarks Gallery",
  "version": "1.0",
  "description": "View your Twitter bookmarks as an image gallery",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*/bookmarks",
        "https://x.com/*/bookmarks"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitter Bookmarks Gallery"
  }
}